# ============================================
# 环境变量模板（复制为 .env 后填写真实值）
# 注意：.env 本身已被 .gitignore 忽略，不会进版本库
# ============================================

# DeepSeek API Key（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 云端 TTS 凭据（本地语音模式不需要）
TTS_APP_ID=your-tts-app-id
TTS_ACCESS_TOKEN=your-tts-access-token

# PostgreSQL 连接串（宿主机 15432 映射到容器内 PostgreSQL 5432）
# 改密码后必须同步更新此变量，应用靠 load_dotenv + PG_DSN 覆盖连接
PG_DSN=postgresql://postgres:yourpassword@localhost:15432/robot
POSTGRES_PASSWORD=yourpassword

AUTO_ROUTER_TIMEOUT_SECONDS=15
AUTO_ROUTER_MIN_CONFIDENCE=0.65
HYBRID_MAX_CONTEXT_CHARS=10000
HYBRID_MAX_SOURCE_CHARS=2000
HYBRID_MODEL_TIMEOUT_SECONDS=60

# SenseVoice 默认自动发现 ~/.cache/modelscope/iic/SenseVoiceSmall。
# 自定义位置时填写绝对路径；默认禁止应用启动时联网下载。
ASR_MODEL_PATH=
ASR_ALLOW_DOWNLOAD=0

# 搜索模块
RESEARCH_WORKER_POLL_SECONDS=2
RESEARCH_MAX_ATTEMPTS=2
RESEARCH_RETRY_BASE_SECONDS=2
RESEARCH_RETRY_MAX_SECONDS=60
RESEARCH_RETRY_JITTER_SECONDS=0.5
RESEARCH_MAX_SEARCH_QUERIES=5
RESEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_SOURCES=12
RESEARCH_MAX_CONTEXT_CHARS=50000
RESEARCH_FETCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_RESPONSE_BYTES=2000000
RESEARCH_MAX_SOURCE_CHARS=8000
RESEARCH_MODEL_TIMEOUT_SECONDS=120
RESEARCH_MODEL_INPUT_COST_PER_1K_USD=0
RESEARCH_MODEL_OUTPUT_COST_PER_1K_USD=0
RESEARCH_TASK_TIMEOUT_SECONDS=600
RESEARCH_TASK_LEASE_SECONDS=120
RESEARCH_LEASE_RENEW_SECONDS=30
RESEARCH_RECOVERY_SCAN_SECONDS=15

RESEARCH_ARTIFACT_STORAGE_PATH=data/research/artifacts
RESEARCH_ARTIFACT_TTL_DAYS=30
RESEARCH_EXPORT_MAX_SIZE_MB=50
RESEARCH_EXPORT_POLL_SECONDS=1
RESEARCH_EXPORT_TIMEOUT_SECONDS=180
RESEARCH_ARTIFACT_CLEANUP_SECONDS=3600
RESEARCH_ARTIFACT_CLEANUP_BATCH_SIZE=100
RESEARCH_PDF_CONVERTER=word
MICROSOFT_WORD_BINARY=C:\Program Files\Microsoft Office\root\Office16\WINWORD.EXE

MODEL_GATEWAY_TIMEOUT_SECONDS=60
MODEL_GATEWAY_MAX_ATTEMPTS=2
MODEL_GATEWAY_RETRY_BASE_SECONDS=0.5
MODEL_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_GATEWAY_CIRCUIT_RECOVERY_SECONDS=30
MODEL_GATEWAY_REQUEST_INPUT_TOKENS=100000
MODEL_GATEWAY_REQUEST_OUTPUT_TOKENS=20000
MODEL_GATEWAY_AUDIT_ENABLED=true
