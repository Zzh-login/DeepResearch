# ────────────────────────────────
# Python 缓存 / 编译产物
# ────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ────────────────────────────────
# 依赖与模型权重（体积巨大，不进版本库）
# venv 可凭 requirements.txt 重建；models 为本地 BGE-M3 权重
# ────────────────────────────────
venv/
models/

# ────────────────────────────────
# 密钥 / 凭据（绝不可提交！）
# .env 含 DeepSeek Key / TTS 凭据 / PG 密码
# ────────────────────────────────
.env
*.key
*.pem
*.secret
.jwt_secret
credentials*

# ────────────────────────────────
# 日志 / 临时探针 / 文档生成产物
# ────────────────────────────────
*.log
latency_probe.py
.docx_assets/

# ────────────────────────────────
# 运行时数据（隐私 / 账号库，不进版本库）
# 仅排除“数据”，保留 data/ 下的源配置（*.yaml, schema.sql）
# ────────────────────────────────
data/users/*
!data/users/.gitkeep
data/*.json
data/*.db

# ────────────────────────────────
# 编辑器 / 系统
# ────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

# ────────────────────────────────
# 内部工作记忆（Agent 私有，非项目代码）
# ────────────────────────────────
.workbuddy/
# 开发草稿 / 探针文件（不进版本库）
code_review_report.md
vector_repo_async_fix_plan.md
